{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/near/[route].js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/ledger",
      "destination": "/index.html"
    },
    {
      "source": "/inspect",
      "destination": "/index.html"
    },
    {
      "source": "/inspect/:account",
      "destination": "/index.html"
    }
  ]
}
