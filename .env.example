# Copy to .env.local (git-ignored) and fill in. Every value is optional: with none set the game runs fully local
# and says so. All variables are read server-side only (vite.config.ts loads NEAR_*; nothing reaches client code).

# Relayer: a NEAR testnet account that pays gas and owns the market contract. If the key is empty, the relayer
# falls back to ~/.near-credentials/testnet/<NEAR_RELAYER_ID>.json.
NEAR_RELAYER_ID=
NEAR_RELAYER_KEY=
# Defaults: market.<NEAR_RELAYER_ID> and https://rpc.testnet.fastnear.com
NEAR_CONTRACT_ID=
NEAR_RPC_URL=
# Seed for merchant and resident function-call keys (any long random string; keep it secret)
NEAR_MERCHANT_SECRET=

# Google/email sign-in through Auth0 (optional)
NEAR_AUTH0_DOMAIN=
NEAR_AUTH0_CLIENT_ID=

# "Ask a merchant why" phrased by NEAR AI (optional; without it the answer is a scripted line from the same facts)
NEAR_AI_KEY=
NEAR_AI_MODEL=

# Rate limits and cloud saves on Vercel (optional; local dev uses an in-memory limiter)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Only for regenerating audio with scripts/audio/generate.ts (spends ElevenLabs credits)
ELEVENLABS_API_KEY=
# NEAR AI agent decisions (server/near/agent.ts). Off unless both NEAR_AI_KEY and NEAR_AGENT_MERCHANTS are set.
# NEAR_AGENT_MERCHANTS: comma list of agents that may decide: pema,tomas,mira,arin (merchants), picker,porter (Lin, Dev).
# Enable one at a time. Paid decisions only happen on scheduler turns (below), never on players' browser requests.
NEAR_AGENT_MERCHANTS=
# NEAR_AI_DECISION_MODEL=typesafe/jev-1.13
# NEAR_AI_SYSTEMONE_URL=https://cloud-api.near.ai/v1/systemone
# Conversation model for free-form dialogue (an OpenAI-compatible model id on cloud-api.near.ai; falls back to
# NEAR_AI_MODEL). Without it, answers are scripted lines chosen by topic from the same facts.
# Chosen: google/gemini-2.5-flash-lite (fast, no reasoning step; 0.1 / 0.4 USD per million input / output tokens per
# cloud-api.near.ai/v1/models on 2026-11-13). Each line is ~600 input + ~60 output tokens, about 0.0001 USD.
NEAR_AI_CHAT_MODEL=

# Autonomous market (server/near/ops.ts)
# players (default): browsers' 60 s requests move the market, rule prices or a decision already made today.
# scheduler: only GET/POST /api/near/market-turn with "Authorization: Bearer <secret>" moves it (Vercel Cron or
# scripts/near/agents.ts turn --yes); browser requests change nothing.
NEAR_MARKET_DRIVER=
# Shared secret for the scheduler route (Vercel Cron sends CRON_SECRET automatically)
NEAR_SCHEDULER_SECRET=
# Kill switch: 1 = no agent uses NEAR AI (rule prices everywhere). Runtime switch: scripts/near/agents.ts halt|resume
NEAR_AGENTS_OFF=
# Paid calls per UTC day, all agents together (defaults 200 / 300 / 200; 0 = none)
NEAR_AI_DAILY_DECISIONS=
NEAR_AI_DAILY_CHATS=
NEAR_AI_DAILY_VERIFIES=
# 1 = market turns driven by players' browsers may also ask NEAR AI (still one decision per agent per market day and
# inside NEAR_AI_DAILY_DECISIONS), so agents decide during ordinary play. Unset = only scheduler turns decide.
NEAR_AGENTS_IN_PLAY=
# Paid retry of a failed decision request (default 1; 0 for controlled runs)
NEAR_AI_DECISION_RETRIES=
# Vercel Cron sends this as the scheduler's bearer secret (alternative to NEAR_SCHEDULER_SECRET)
CRON_SECRET=

# Voice: a lower shared character cap for a bounded live test (never raises the default). 1 = mock voice for local QA
# (ignored when VERCEL_ENV is production).
VIVOLITH_VOICE_DAILY_CHARS=
VIVOLITH_VOICE_MOCK=

# Playtest caps for a bounded live run (unset = no cap): at most N market turns and M market transactions per run id
NEAR_TEST_RUN=
NEAR_TEST_TURNS=
NEAR_TEST_TXS=

# Accepted aliases: NEAR_ACCOUNT_ID / NEAR_PRIVATE_KEY for NEAR_RELAYER_ID / NEAR_RELAYER_KEY, and Vercel KV's
# KV_REST_API_URL / KV_REST_API_TOKEN for the Upstash variables.
