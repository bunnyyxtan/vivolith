{
  "name": "vivolith",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "VIVOLITH: Saltlight Row. A browser 3D market-town game where every merchant has a wallet and the street remembers your deals.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-api.mjs",
    "build:api": "node scripts/build-api.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 \"src/**/*.check.ts\" \"server/**/*.check.ts\"",
    "verify": "node scripts/near/verify.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "2.11.3",
    "near-api-js": "7.4.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@elevenlabs/elevenlabs-js": "^2.77.0",
    "@types/three": "0.187.0",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  }
}
